# Reference values only. Export variables explicitly; no automatic .env loading.
PORT=8080
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_SECS=10
# A persistent file path, resolved relative to the backend's working directory.
SQLITE_PATH=data/kitternel.db
# Built frontend assets, relative to the backend working directory.
FRONTEND_DIR=../frontend/dist
# Compose only: HOST_PORT changes the loopback host mapping, not the internal PORT.
# HOST_PORT=8081
